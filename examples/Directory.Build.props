<Project>
  <!-- Shared by every add-on and example. Game and Harmony come from public reference
       packages, so nothing from your RimWorld folder is needed to build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(MSBuildProjectDirectory)/../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5013-unstable" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.7" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Ship RimworldMultiplayer.Api.dll next to your add-on's DLL. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/RimworldMultiplayer.Api/RimworldMultiplayer.Api.csproj" />
  </ItemGroup>
</Project>
